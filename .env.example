# --- PostgreSQL / PostGIS ---
# Mật khẩu dưới đây chỉ để chạy thử trên máy cá nhân, hãy đổi khi triển khai thật
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=poultry_disease
POSTGRES_TEST_DB=poultry_disease_test

# DATABASE_URL chạy production (đường dẫn tới service db trong compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/poultry_disease

# TEST_DATABASE_URL dùng khi chạy pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/poultry_disease_test

# --- Bảo mật ---
# BẮT BUỘC điền, tối thiểu 32 ký tự. Tạo khóa bằng lệnh:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Mật khẩu cho tài khoản mẫu admin và user khi chạy seed. Để trống thì seed tự sinh và in ra một lần.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# --- Cảnh báo geospatial ---
DEFAULT_ALERT_RADIUS_KM=5.0

# --- Nguồn dữ liệu ổ dịch (tùy chọn) ---
# URL nguồn JSON mà bạn tin cậy, nhiều nguồn cách nhau bằng dấu phẩy. Để trống thì không nhập gì.
# Dữ liệu nhập về luôn chưa xác nhận, cán bộ phải xác nhận rồi mới tạo được cảnh báo.
OUTBREAK_FEED_URLS=
# Tự nhập theo chu kỳ (phút). 0 là tắt, chỉ nhập khi cán bộ bấm nút.
OUTBREAK_CRAWL_INTERVAL_MINUTES=0
# --- Email (SMTP) ---
# Bật để gửi email cảnh báo tới trang trại có điền email. Tắt thì chỉ in ra console.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail cần "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu đăng nhập thường
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Cảnh báo dịch gia cầm
SMTP_USE_TLS=true
SMTP_USE_SSL=false
