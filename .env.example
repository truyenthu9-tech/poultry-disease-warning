# --- PostgreSQL / PostGIS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=poultry_disease
POSTGRES_TEST_DB=poultry_disease_test

# DATABASE_URL chạy production (đường dẫn tới service db trong compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/poultry_disease

# TEST_DATABASE_URL dùng khi chạy pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/poultry_disease_test

# --- Cảnh báo geospatial ---
DEFAULT_ALERT_RADIUS_KM=5.0